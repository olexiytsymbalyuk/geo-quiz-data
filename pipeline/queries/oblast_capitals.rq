# Чинні адміністративні центри областей: код області (P9435) -> код центру (P36 -> P9435).
# Пропускаємо твердження з кінцем дії (P582, напр. колишній центр) і deprecated.
# Код області: UA + 2 цифри + 9 нулів + 6 цифр. Міток немає зовсім.
SELECT ?oblastCode ?centerCode WHERE {
  ?oblast wdt:P9435 ?oblastCode ;
          p:P36 ?capitalStatement .
  ?capitalStatement ps:P36 ?center ;
                    wikibase:rank ?rank .
  ?center wdt:P9435 ?centerCode .
  FILTER(?rank != wikibase:DeprecatedRank)
  FILTER NOT EXISTS { ?capitalStatement pq:P582 ?endTime . }
  FILTER(REGEX(STR(?oblastCode), "^UA[0-9]{2}0{9}[0-9]{6}$"))
}
